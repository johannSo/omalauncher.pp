<!-- Settings › linux › snapshots: snapshots of the Linux system to roll back to. -->
<resources>
    <string name="snapshots_title">снимки</string>
    <string name="snapshots_row_none">пока нет · откатите обновление, которое что-то сломало</string>
    <plurals name="snapshots_row">
