<!-- Settings › linux › snapshots: snapshots of the Linux system to roll back to. -->
<resources>
    <string name="snapshots_title">快照</string>
    <string name="snapshots_row_none">暂无 · 回滚搞坏了东西的更新</string>
    <plurals name="snapshots_row">
        <item quantity="other">%d 个可回滚的快照</item>
    </plurals>
    <string name="snapshots_body">快照会把 Linux 系统保存为当前的样子：它的软件包以及 /etc、/usr、/var 和 /opt 中的所有内容。恢复快照可以回滚搞坏了东西的更新。/root 和 /home（你自己的文件）保持原样，除非你另行选择。快照之间共享未改变的内容，所以更新后拍的快照只占用它所改动部分的空间。</string>
    <string name="snapshots_storage">可用 %1$s · 快照占用 %2$s</string>
    <string name="snapshots_take">立即拍快照</string>
    <string name="snapshots_low_space">存储空间不足：空间不够时会跳过更新前的快照</string>
